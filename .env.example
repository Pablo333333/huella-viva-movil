EXPO_PUBLIC_API_URL=http://192.168.0.1:4000

# Requerido para APK/AAB nativos (EAS Build). En Expo Go no hace falta.
# Crea la clave en Google Cloud Console con Maps SDK for Android habilitado.
# Restringe por package: com.huellaviva.app + SHA-1 del keystore (EAS Credentials).
GOOGLE_MAPS_API_KEY=
# Opcional: claves separadas por plataforma
# GOOGLE_MAPS_API_KEY_ANDROID=
# GOOGLE_MAPS_API_KEY_IOS=
